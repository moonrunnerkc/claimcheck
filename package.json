{
  "name": "claimcheck",
  "version": "0.1.0",
  "description": "A deterministic, pre-merge gate that tries to falsify a pull request's own claim about what it does, using only the PR and the repository.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "claimcheck": "./dist/cli/run.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "CLAIMCHECK_LIVE=1 vitest run --config vitest.live.config.ts",
    "eval": "tsx eval/harness.ts",
    "claimcheck": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}

{
  "name": "claimcheck",
  "version": "0.1.0",
  "description": "A deterministic, pre-merge gate that tries to falsify a pull request's own claim about what it does, using only the PR and the repository.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "claimcheck": "./dist/cli/run.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/harness.ts",
    "claimcheck": "tsx src/cli/run.ts"
  },
  "dependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "v8-to-istanbul": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
